NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://mc.modpack.aron.best
RUNTIME_DIRECTORY=.runtime
# Generated by npm run invite. Keep this private. No accounts or login form.
FRIEND_ACCESS_TOKEN=
MINECRAFT_VERSION=26.3
FABRIC_LOADER_VERSION=0.19.5
JAVA_PATH=/opt/homebrew/opt/openjdk@25/bin/java
MINECRAFT_MEMORY_MB=4096
MINECRAFT_ADDRESS=mc.aron.best
MINECRAFT_AUTOSTART=false
# API keys stay on the server, never in Angular or git.
CURSEFORGE_API_KEY=
CURSEFORGE_UPLOAD_TOKEN=
CURSEFORGE_PROJECT_ID=
CURSEFORGE_EXPORT_PATH=
