{
	admin off
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	servers {
		protocols h1 h2
		timeouts {
			read_header 5s
			read_body 120s
			idle 30s
		}
		max_header_size 16KB
	}
}

(application) {
	encode zstd gzip
	request_body {
		max_size 172MB
	}
	header -Server
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up -Forwarded
		transport http {
			dial_timeout 3s
			response_header_timeout 120s
		}
	}
}

{$PORTFOLIO_HOST}, {$PORTFOLIO_ALIAS} {
	@management path /api /api/*
	respond @management 404
	import application
}

{$WORKSHOP_HOST} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	import application
}
